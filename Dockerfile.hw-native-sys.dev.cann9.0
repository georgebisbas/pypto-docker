# syntax=docker/dockerfile:1
# Personal dev layer on top of pypto3-hw-native-sys:cann9.
#
# Bakes your git identity + (optionally) a fork remote + an editable install
# so a `docker run` drops you straight into a ready-to-hack pypto checkout,
# instead of re-running the same setup by hand every time. Defaults are
# generic — pass --build-arg GIT_USER_NAME/GIT_USER_EMAIL/FORK_REMOTE_URL to
# personalize (see ../pypto-tooling/personal_setup.md for one example).
#
# PREREQUISITE — build the base image first:
#   ./scripts/build-npu-images.sh pypto
#   (or: docker build -t pypto3-hw-native-sys:cann9 - < Dockerfile.hw-native-sys.cann9.0)
#
# BUILD:
#   docker build -t pypto3-dev:cann9 -f Dockerfile.hw-native-sys.dev.cann9.0 .
#
# BUILD (custom identity / fork / base image tag):
#   docker build \
#     --build-arg BASE_IMAGE=pypto3-hw-native-sys:cann9 \
#     --build-arg GIT_USER_NAME="Your Name" \
#     --build-arg GIT_USER_EMAIL="you@example.com" \
#     --build-arg FORK_REMOTE_NAME=fork-yourname \
#     --build-arg FORK_REMOTE_URL=https://github.com/yourname/pypto.git \
#     -t pypto3-dev:cann9 -f Dockerfile.hw-native-sys.dev.cann9.0 .
#
# RUN: identical flags to pypto3-hw-native-sys:cann9 — see that Dockerfile's
# RUN section (single-device vs multi-device/HCCL with --pid=host).
#
# INSIDE CONTAINER (only if FORK_REMOTE_URL was set at build time):
#   cd ${PYPTO_DIR}
#   git checkout -b my-branch <fork-remote>/some-remote-branch
#   pip install --no-build-isolation -e ".[dev]"   # only needed again after checkout
#
# HCCL: LD_PRELOAD is intentionally NOT baked in here either — same VS Code
# attach-hang reason as the base image (debugging_skills/SKILL.md). A
# `hccl-preload` shell function is defined below; call it manually before
# HCCL/distributed tests — defining it does not export anything by itself:
#   hccl-preload && pytest tests/st/distributed/... --platform=a2a3 --device="0,1"

ARG BASE_IMAGE=pypto3-hw-native-sys:cann9
FROM ${BASE_IMAGE}

# Claude Code CLI (native installer — no Node needed; x86_64 + aarch64).
# Placed right after FROM so edits to the git/editable-install layers below
# don't reinstall (or silently upgrade) Claude. A new BASE_IMAGE still
# re-runs it — nothing in a child layer can avoid that.
# Pass --build-arg INSTALL_CLAUDE=0 to skip. No credentials are baked in —
# authenticate at `docker run` time (see README "Claude Code in containers").
ARG INSTALL_CLAUDE=1
ARG CLAUDE_VERSION=stable
RUN if [ "${INSTALL_CLAUDE}" = "1" ]; then \
      curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_VERSION}" && \
      ln -sf /root/.local/bin/claude /usr/local/bin/claude && \
      claude --version; \
    fi
# Keep the image reproducible; rebuild with a new CLAUDE_VERSION to upgrade.
ENV DISABLE_AUTOUPDATER=1

ARG GIT_USER_NAME="Your Name"
ARG GIT_USER_EMAIL="you@example.com"
ARG FORK_REMOTE_NAME=
ARG FORK_REMOTE_URL=

RUN git config --global user.name "${GIT_USER_NAME}" && \
    git config --global user.email "${GIT_USER_EMAIL}" && \
    git config --global pull.rebase true && \
    git config --global --add safe.directory "${PYPTO_DIR}"

# No personal fork is configured unless FORK_REMOTE_URL is passed via
# --build-arg — generic defaults above so a plain `docker build` doesn't bake
# in someone else's identity/fork. Best-effort: don't fail the build if the
# fork is unreachable (e.g. offline rebuild).
RUN if [ -n "${FORK_REMOTE_URL}" ]; then \
      cd "${PYPTO_DIR}" && \
      git remote add "${FORK_REMOTE_NAME:-fork}" "${FORK_REMOTE_URL}" && \
      (git fetch "${FORK_REMOTE_NAME:-fork}" || echo "WARNING: could not fetch ${FORK_REMOTE_NAME:-fork} at build time — run 'git fetch ${FORK_REMOTE_NAME:-fork}' inside the container"); \
    fi

# Base image installs pypto non-editably (pip install ".[dev]"). Re-install
# editable so source edits made inside the container (e.g. after checking out
# a fork branch) take effect without a full reinstall.
RUN --mount=type=cache,target=/root/.cache/pip \
    cd "${PYPTO_DIR}" && pip install --no-build-isolation -e ".[dev]"

# hccl-preload shell function is inherited from the base image.

WORKDIR ${PYPTO_DIR}
CMD ["bash"]
