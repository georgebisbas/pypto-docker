# One-time setup: copy this file to scripts/dev-identity.env (gitignored) and
# fill in your own values. build-npu-dev-images.sh sources it automatically,
# so you never need to export these by hand.
#
#   cp scripts/dev-identity.env.example scripts/dev-identity.env
#   # edit scripts/dev-identity.env with your values
#   ./scripts/build-npu-dev-images.sh

export GIT_USER_NAME="Your Name"
export GIT_USER_EMAIL="you@example.com"

# Optional: only needed if you push from inside the dev container to your
# own fork. Leave unset/empty to build without a fork remote configured.
export PYPTO_FORK_REMOTE_NAME="fork-yourname"
export PYPTO_FORK_REMOTE_URL="https://github.com/yourname/pypto.git"
export SIMPLER_FORK_REMOTE_NAME="fork-yourname"
export SIMPLER_FORK_REMOTE_URL="https://github.com/yourname/simpler.git"
