# syntax=docker/dockerfile:1
# Standalone PyPTO dev image for Ascend 910B
#
# No local files required — everything is cloned from GitHub at build time.
# No build context needed; build from any directory.
#
# All paths are driven by build args:
#   CANN_VERSION    (default: 9.0.0)    — selects base image tag and all cann-* paths
#   INSTALL_PREFIX  (default: /opt)     — root for pypto, pto-isa, ptoas installs
#   PYPTO_COMMIT    (default: full SHA of github main) — must exist on github.com/hw-native-sys/pypto
#                   Use 40-char SHA when pinning an older commit (GitHub fetch rejects short SHAs).
#   PTO_ISA_COMMIT  (default: auto)     — pto-isa commit; auto-derived from runtime/pto_isa.pin if not set
#   PTOAS_VERSION   (default: v0.72)    — PTOAS release (must match pypto CI)
#
# REQUIREMENTS:
#   - Internet access during build (GitHub)
#   - Ascend 910B NPUs + host driver at runtime
#   - CANN >= 9.0.0 (9.0.0 and 9.2.0-beta.1 are built/tested)
#
# SCOPE: real NPU execution tested only on a2a3 platform.
#   a2a3sim needs real GCC 15+ (_Float16 in pto-isa CPU sim); the build installs
#   gcc-15/g++-15 from ubuntu-toolchain-r/test when available.
#   CANN 9.2.0-beta.1 ships its own unrelated `pypto` distribution (0.2.1; it
#   also owns pypto_pro/) under python/site-packages. Installing this project's
#   pypto makes pip uninstall that name conflict, and the build also prepends
#   the interpreter's purelib to PYTHONPATH — because the base image's
#   ENTRYPOINT re-prepends CANN's paths to PYTHONPATH on every `docker run`
#   (see near the end). CANN's pypto_pro is therefore unavailable here.
#
# BUILD (defaults):
#   docker build -t pypto3-hw-native-sys:cann9 - < Dockerfile.hw-native-sys.cann9.0
#
# BUILD (CANN 9.2, as used for the 9.2 images):
#   docker build --build-arg CANN_VERSION=9.2.0-beta.1 -t pypto3-hw-native-sys:cann9.2 - < Dockerfile.hw-native-sys.cann9.0
#
# BUILD (custom prefix / pinned pto-isa / different commit):
#   docker build --build-arg PYPTO_COMMIT=eab28d0c911b7042fb7fb8b87aa73fc0ff627a6c -t pypto3-hw-native-sys:cann9 - < Dockerfile.hw-native-sys.cann9.0
#
# RUN (single-device, NO HCCL):
#   docker run --rm -it --privileged --ipc=host -v /usr/local/bin/npu-smi:/usr/local/bin/npu-smi:ro -v /usr/local/Ascend/driver:/usr/local/Ascend/driver:ro -v /dev:/dev pypto3-hw-native-sys:cann9
#
# RUN (multi-device, distributed / HCCL — MUST use --pid=host):
#   docker run --rm -it --privileged --ipc=host --pid=host --cap-add=SYS_PTRACE --security-opt seccomp=unconfined -v /usr/local/bin/npu-smi:/usr/local/bin/npu-smi:ro -v /usr/local/Ascend/driver:/usr/local/Ascend/driver:ro -v /dev:/dev pypto3-hw-native-sys:cann9
#
#   --pid=host is required: Ascend IPC validates host PIDs, not container PIDs.
#   See ../pypto-tooling/debugging_skills/SKILL.md → "Docker runtime: HCCL".
# COMMANDS INSIDE CONTAINER — mirrors pypto .github/workflows/ci.yml job order.
#   INSTALL_PREFIX=/opt, CANN_VERSION=9.0.0. CANN env is sourced from bash.bashrc.
#   Device lists are inlined below (change 0,1,2,3 / 0 to match your host).
#   PTO-ISA: image auto-derives from runtime/pto_isa.pin (currently 5487a6b0e8d9bd3653dbee8d7c874c667ee8db2f)
#   unless PTO_ISA_COMMIT was overridden at build.
#
#   cd /opt/pypto
#   npu-smi info
#   python -c "import pypto; print('pypto ok')"
#   which ptoas; ptoas --version
#
#   # --- unit-tests (job: unit-tests; CPU only, no NPU) ---
#   pytest tests/ut -n auto --maxprocesses 8 -v
#
#   # --- codegen-tests (job: codegen-tests; CPU, no device / no ptoas / no pto-isa) ---
#   # test_torch_codegen_paged_attention excluded here (unstable CPU golden); runs in system-tests on NPU.
#   python -m pytest tests/st/codegen -v --codegen-only --ignore=tests/st/codegen/torch/test_torch_codegen_paged_attention.py
#
#   # --- clang-tidy (job: clang-tidy; arm64 CPU in CI) ---
#   python tests/lint/clang_tidy.py --strict-version --jobs=$(nproc)
#
#   # --- system-tests (jobs: system-tests / system-tests-direct; NPU in CI) ---
#   # CI splits tests/st into two batched shards plus direct-device and DFX steps.
#   # Shard A — heavy dirs (all but ops/cross_core), batched:
#   python -m pytest tests/st -v -m "device_batch and not swimlane and not multi_card" \
#     --ignore=tests/st/distributed --ignore=tests/st/codegen \
#     --ignore=tests/st/runtime/ops --ignore=tests/st/runtime/cross_core \
#     --ignore=tests/st/runtime/framework_and_models/test_dump_tag.py \
#     --precompile-workers=32 --strict-case-discovery --device="0,1,2,3"
#   # Shard B — ops + cross_core, batched:
#   python -m pytest tests/st/runtime/ops tests/st/runtime/cross_core -v -m device_batch \
#     --precompile-workers=32 --strict-case-discovery --device="0,1,2,3"
#   # Direct-device — the remaining in-process tests, one card:
#   python -m pytest tests/st -v -m "not device_batch and not multi_card" \
#     --ignore=tests/st/distributed --ignore=tests/st/codegen \
#     --ignore=tests/st/runtime/framework_and_models/test_perf_swimlane.py \
#     --ignore=tests/st/runtime/framework_and_models/test_graph_execution.py \
#     --deselect=tests/st/runtime/framework_and_models/test_jit.py::TestJITExecution::test_persistent_cache_across_processes \
#     --device=0 --platform=a2a3
#   # Paged-attention codegen golden (device env):
#   python -m pytest tests/st/codegen/torch/test_torch_codegen_paged_attention.py -v --device=0 --platform=a2a3
#   # L2 multi-orch — separate pytest process (Worker level=2 poisons level=3 in the same process).
#   python -m pytest tests/st/distributed/test_l2_multi_orch.py -v --device=0
#   # Swimlane — needs --enable-chip-swimlane + --precompile-workers (no --forked).
#   python -m pytest tests/st/runtime/framework_and_models/test_perf_swimlane.py -v --device=0 --platform=a2a3 --enable-chip-swimlane --precompile-workers=8
#   # Scheduling swimlane assertions — selected by the `swimlane` marker.
#   python -m pytest tests/st/runtime/scheduling -v -m swimlane --device=0 --platform=a2a3 --enable-chip-swimlane --precompile-workers=8 --strict-case-discovery
#   # Graph record-and-replay — one process per test.
#   python -m pytest tests/st/runtime/framework_and_models/test_graph_execution.py -v --device=0 --platform=a2a3 --forked
#   # Dump-args — single device, forked.
#   python -m pytest tests/st/runtime/framework_and_models/test_dump_tag.py -v --device=0 --platform=a2a3 --dump-args --forked
#
#   # --- dist-system-tests (job: dist-system-tests; HCCL, bare-metal in CI) ---
#   # CI runs without a GHA container; in Docker use --pid=host (see RUN block).
#   # Set LD_PRELOAD before running (not image-wide — would break VS Code attach):
#   export LD_PRELOAD=${CANN_HOME}/aarch64-linux/lib64/libhccl.so
#   python -m pytest tests/st/distributed -v -n 6 --device-group-size 2 --device="0,1,2,3" --ignore=tests/st/distributed/test_l2_multi_orch.py
#   # Multi-card cases outside tests/st/distributed:
#   python -m pytest tests/st -v -m multi_card --ignore=tests/st/distributed --device="0,1,2,3" --platform=a2a3
#
#   # --- Not covered by this image / CI job mapping ---
#   # pre-commit: pre-commit run --all-files  (job: pre-commit; needs .git checkout hooks)
#   # pypto-lib-model: clones pypto-lib and runs Qwen3/DeepSeek decode scripts on one NPU
#   # system-tests-a5sim / a2a3sim: x86 simulator job (out of scope for this 910B image)
#
#   # --- simpler runtime (submodule; extra docker workflows — not pypto ci.yml jobs) ---
#   cd /opt/pypto/runtime
#   pip install --no-build-isolation .   # after editing runtime sources
#   pytest tests/ut -m "not requires_hardware" -v --clone-protocol https
#   pytest tests -m requires_hardware --platform a2a3 --device 0,1,2,3 -v --ignore=tests/ut/py/test_worker/test_dynamic_alloc_hw.py --ignore=tests/ut/py/test_worker/test_platform_comm.py
#   pytest tests/st/a2a3/ -v --platform a2a3 --device 0,1,2,3 --pto-session-timeout 600 --clone-protocol https --require-pto-isa
#   # HCCL UT + L3 examples — container MUST use --pid=host.
#   # LD_PRELOAD is NOT set image-wide (would break VS Code attach). Set it in your shell first:
#   export LD_PRELOAD=${CANN_HOME}/aarch64-linux/lib64/libhccl.so
#   pytest tests/ut/py/test_worker/test_dynamic_alloc_hw.py tests/ut/py/test_worker/test_platform_comm.py -m requires_hardware --platform a2a3 --device 0,1,2,3 -v
#   pytest examples/workers/l3/ tests/st/worker/comm_domain/deferred_notify tests/st/worker/comm_domain/async_notify examples/a2a3/tensormap_and_ringbuffer/sdma_async_completion_demo -v --platform a2a3 --device 0,1,2,3 --pto-session-timeout 600 --clone-protocol https --require-pto-isa

# ARG before FROM: drives the base image tag.
ARG CANN_VERSION=9.0.0
FROM quay.io/ascend/cann:${CANN_VERSION}-910b-ubuntu22.04-py3.12

# Re-declare after FROM (ARG scope resets after each FROM).
ARG CANN_VERSION=9.0.0
ARG INSTALL_PREFIX=/opt

# Persist as ENV so all subsequent instructions can reference them.
ENV CANN_VERSION=${CANN_VERSION} \
    INSTALL_PREFIX=${INSTALL_PREFIX}

# Derived paths — all other paths flow from these two.
ENV CANN_HOME=/usr/local/Ascend/cann-${CANN_VERSION}
ENV PYPTO_DIR=${INSTALL_PREFIX}/pypto \
    PTO_ISA_DIR=${INSTALL_PREFIX}/pto-isa \
    PTOAS_DIR=${INSTALL_PREFIX}/ptoas-bin

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# apt cache/lists are BuildKit cache mounts, not image layers — no rm -rf needed.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      git curl ca-certificates software-properties-common gnupg \
      python3.10 python3.10-venv \
      ccache \
      build-essential cmake ninja-build pkg-config \
      graphviz \
      mpich libmpich-dev \
      ripgrep fd-find nano \
      bash-completion gh && \
    ln -sf "$(command -v fdfind)" /usr/local/bin/fd && \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt-get update && \
    (apt-get install -y --no-install-recommends gcc-15 g++-15 || true) && \
    if ! command -v g++-15 >/dev/null 2>&1; then \
      echo "WARNING: g++-15 unavailable; aliasing $(g++ -dumpversion) as g++-15"; \
      ln -sf "$(command -v g++)" /usr/local/bin/g++-15; \
    fi && \
    if ! command -v gcc-15 >/dev/null 2>&1; then \
      echo "WARNING: gcc-15 unavailable; aliasing $(gcc -dumpversion) as gcc-15"; \
      ln -sf "$(command -v gcc)" /usr/local/bin/gcc-15; \
    fi

ENV CC=gcc-15 \
    CXX=g++-15

# Python build toolchain + test deps. Build inputs (and pytest/pytest-forked,
# the --forked-compatible pair) are pinned to pypto's build-constraints.txt —
# the set CI validates — so a rebuild cannot drift into an untested
# nanobind/cmake release (#2492, #2495) or a pytest that breaks --forked (#3204).
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --upgrade pip setuptools wheel && \
    pip install \
      "scikit-build-core==1.0.3" \
      "nanobind==2.15.0" \
      "ninja==1.13.0" \
      "cmake==4.4.2"

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
      "numpy>=2.0" \
      "pytest==9.1.1" "pytest-forked==1.7.5" "pytest-xdist==3.8.0" \
      "pyright==1.1.407" "ruff==0.14.8" "clang-tidy==21.1.0" \
      "pre-commit==4.5.1"

# torch pinned to CI's TORCH_PIN: unpinned resolves to 2.13, whose bf16 codegen
# golden comparison fails (see setup-ci-job/action.yml).
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "torch==2.10.0" --index-url https://download.pytorch.org/whl/cpu

# Clone pypto at the pinned commit (changing PYPTO_COMMIT busts the layer cache automatically).
# Uses a blobless clone (--filter=blob:none) so any commit SHA can be checked out;
# GitHub does not allow shallow-fetching arbitrary SHAs directly.
ARG PYPTO_COMMIT=eab28d0c911b7042fb7fb8b87aa73fc0ff627a6c
RUN git clone --filter=blob:none https://github.com/hw-native-sys/pypto.git "${PYPTO_DIR}" && \
    if ! git -C "${PYPTO_DIR}" cat-file -e "${PYPTO_COMMIT}^{commit}" 2>/dev/null; then \
      git -C "${PYPTO_DIR}" fetch origin "${PYPTO_COMMIT}"; \
    fi && \
    git -C "${PYPTO_DIR}" checkout "${PYPTO_COMMIT}" && \
    for i in 1 2 3; do \
      git -C "${PYPTO_DIR}" submodule update --init --recursive && break || sleep 5; \
    done

WORKDIR ${PYPTO_DIR}

# Ensure required third-party sources exist (submodule or fallback clone).
# simpler is always the runtime submodule — no fallback clone needed.
RUN if [ ! -f 3rdparty/libbacktrace/configure.ac ]; then \
      rm -rf 3rdparty/libbacktrace && \
      git clone --depth 1 \
        https://github.com/ianlancetaylor/libbacktrace.git 3rdparty/libbacktrace; \
    fi && \
    if [ ! -f 3rdparty/msgpack-c/include/msgpack.hpp ]; then \
      rm -rf 3rdparty/msgpack-c && \
      git clone --depth 1 --branch cpp_master \
        https://github.com/msgpack/msgpack-c.git 3rdparty/msgpack-c; \
    fi && \
    test -f 3rdparty/libbacktrace/configure.ac && \
    test -f 3rdparty/msgpack-c/include/msgpack.hpp && \
    test -f runtime/pyproject.toml

# PTO_ISA_COMMIT defaults to empty — auto-derived from runtime/pto_isa.pin
# (the single source of truth per pypto CI toolchain job; see PR #1851).
# Set via --build-arg to pin a specific commit.
ARG PTO_ISA_COMMIT=

# Install PTO-ISA (required by system tests).
# If PTO_ISA_COMMIT was not set via --build-arg, derive it from the runtime
# submodule's runtime/pto_isa.pin (the single source of truth per pypto CI;
# see toolchain job in .github/workflows/ci.yml and PR #1851).
RUN if [ -z "${PTO_ISA_COMMIT}" ]; then \
      PTO_ISA_COMMIT=$(tr -d '[:space:]' < runtime/pto_isa.pin); \
      if ! printf '%s' "${PTO_ISA_COMMIT}" | grep -qE '^[0-9a-f]{40}$'; then \
        echo "ERROR: runtime/pto_isa.pin missing or invalid (expected 40-char hex commit)"; exit 1; \
      fi; \
      echo "Auto-derived PTO_ISA_COMMIT=${PTO_ISA_COMMIT} from runtime/pto_isa.pin"; \
    fi && \
    timeout 60 git clone https://github.com/hw-native-sys/pto-isa.git "${PTO_ISA_DIR}" \
      || { rm -rf "${PTO_ISA_DIR}"; timeout 300 git clone https://gitcode.com/luohuan40/pto-isa.git "${PTO_ISA_DIR}"; } && \
    git -C "${PTO_ISA_DIR}" checkout "${PTO_ISA_COMMIT}" && \
    git -C "${PTO_ISA_DIR}" rev-parse --short HEAD

ENV PTO_ISA_ROOT=${PTO_ISA_DIR}

# Install PTOAS (cp310 manylinux wheel — mirrors pypto CI's toolchain job since
# PR #2291). The wheel is CPython 3.10-only (cp310 ABI tag), so it is
# installed into a dedicated python3.10 venv; the base image is Python 3.12.
ARG PTOAS_VERSION=v0.72
ARG PTOAS_SHA256_X86_64=2cc47b1d4c8ace884fb12f7691e0c368132fefef401060c920bed2a5210e3db7
ARG PTOAS_SHA256_AARCH64=69bd51ccd3d9cc4ad0a6a7b296b46dc533d60b214ded9450fb0f90a83a765ca6
RUN PTOAS_WHEEL="ptoas-${PTOAS_VERSION#v}-cp310-cp310-manylinux_2_34_$(uname -m).whl" && \
    case "$(uname -m)" in \
      x86_64) PTOAS_SHA256="${PTOAS_SHA256_X86_64}" ;; \
      aarch64) PTOAS_SHA256="${PTOAS_SHA256_AARCH64}" ;; \
      *) echo "unsupported architecture: $(uname -m)"; exit 1 ;; \
    esac && \
    curl --fail --location --retry 3 --retry-all-errors \
      "https://github.com/hw-native-sys/PTOAS/releases/download/${PTOAS_VERSION}/${PTOAS_WHEEL}" \
      -o "/tmp/${PTOAS_WHEEL}" && \
    echo "${PTOAS_SHA256}  /tmp/${PTOAS_WHEEL}" | sha256sum -c - && \
    python3.10 -m venv "${PTOAS_DIR}" && \
    "${PTOAS_DIR}/bin/python" -m pip install "/tmp/${PTOAS_WHEEL}" && \
    "${PTOAS_DIR}/bin/ptoas" --version && \
    rm -f "/tmp/${PTOAS_WHEEL}"

# Build simpler runtime extension. Select the same targets pypto's a2a3 CI
# jobs use (setup-ci-job `runtime-targets`): without an explicit list the
# runtime builds every platform the host detects, including A5, and an
# A5 build requires HcclChannelAcquireWithConfig for the URMA provider — an
# API absent from CANN 9.0.0 and 9.2.0-beta.1, so the wheel build fails.
RUN --mount=type=cache,target=/root/.cache/pip \
    rm -rf ./runtime/build && \
    pip install --no-build-isolation \
      --config-settings "build.targets=build_package_a2a3;build_package_sim" ./runtime

# Build and install pypto.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-build-isolation -v ".[dev]"

# Remove set_env.sh auto-sourcing from ALL system/user startup files.
# The Ascend base image injects these hooks; they take 10–30s and break VS Code attach.
# All required env vars are set via ENV below; source manually when needed.
RUN for f in /etc/profile /etc/bash.bashrc /root/.profile /root/.bashrc /root/.bash_profile; do \
      [ -f "$f" ] && sed -i '/set_env\.sh/d' "$f" || true; \
    done && \
    for f in /etc/profile.d/*.sh; do \
      [ -f "$f" ] && sed -i '/set_env\.sh/d' "$f" || true; \
    done

# Unset PTO2_RING_* if the host leaked them in — CI does the same before HCCL pytest.
RUN echo "unset PTO2_RING_HEAP PTO2_RING_TASK_WINDOW PTO2_RING_DEP_POOL 2>/dev/null || true" >> /etc/bash.bashrc

# HCCL preload helper — a function, not an exported var, so it is a no-op
# until explicitly called (safe under VS Code's userEnvProbe). See the
# LD_PRELOAD comment further below for why it isn't exported image-wide.
RUN echo 'hccl-preload() { export LD_PRELOAD="${CANN_HOME}/aarch64-linux/lib64/libhccl.so"; echo "LD_PRELOAD set for this shell: $LD_PRELOAD"; }' >> /etc/bash.bashrc

ENV ASCEND_HOME_PATH=${CANN_HOME} \
    PTO_TILE_LIB_CODE_PATH=${CANN_HOME} \
    ASCEND_OPP_PATH=/usr/local/Ascend/ascend-toolkit/latest/opp \
    MPI_HOME=/usr \
    PTOAS_ROOT=${PTOAS_DIR} \
    SIMPLER_ROOT=${PYPTO_DIR}/runtime \
    PTO_ISA_ROOT=${PTO_ISA_DIR}
ENV LD_LIBRARY_PATH=/usr/local/Ascend/driver/lib64/driver:${CANN_HOME}/aarch64-linux/lib64:/usr/local/Ascend/ascend-toolkit/latest/lib64:${LD_LIBRARY_PATH:-}

# Preload libhccl.so so host_runtime.so's WEAK HCCL symbols resolve at load time.
# Without this, HcclGetRootInfo et al. → NULL → SIGSEGV on comm_init.
# See ../pypto-tooling/debugging_skills/SKILL.md → "Docker runtime: HCCL".
#
# run-side: the container MUST be started with --pid=host for HCCL.
# See ../pypto-tooling/debugging_skills/SKILL.md → "Docker runtime: HCCL".
RUN test -f "${CANN_HOME}/aarch64-linux/lib64/libhccl.so" \
    || (echo "ERROR: libhccl.so missing at ${CANN_HOME}/aarch64-linux/lib64/libhccl.so" \
        && ls -la "${CANN_HOME}/aarch64-linux/lib64/" | grep -i hccl \
        && exit 1)
# LD_PRELOAD is NOT set automatically — setting it image-wide (ENV or bashrc) injects
# libhccl.so into every process including VS Code server → hang on attach.
# Before running HCCL tests, set it in your shell:
#   export LD_PRELOAD=${CANN_HOME}/aarch64-linux/lib64/libhccl.so
# Without it, weak HCCL symbols in host_runtime.so stay NULL → SIGSEGV on comm_init.

# VS Code's userEnvProbe: if it ever captures LD_PRELOAD and injects it into the server,
# override per-container via ~/.devcontainer/devcontainer.json: {"userEnvProbe": "none"}

# Append (never prepend) the PTOAS venv: its bin/ holds the cp310 python3/pip
# pair created for the ptoas wheel, which would shadow the system Python 3.12
# that pypto, scikit-build-core, and pytest live in. pypto resolves `ptoas` via
# PTOAS_ROOT, so PATH order does not affect codegen.
ENV PATH=${PATH}:${PTOAS_DIR}/bin

# CANN 9.2.0-beta.1 ships a `pypto` distribution (0.2.1, pybind11-based,
# unrelated to this project; it also owns pypto_pro/) in its
# python/site-packages. Installing this project's pypto below makes pip
# uninstall that name conflict, which is what ultimately keeps `import pypto`
# ours: the CANN base image's ENTRYPOINT re-prepends CANN's directories to
# PYTHONPATH on every `docker run`, so ENV order alone cannot win. The purelib
# symlink is kept and placed first for direct Python launches and to mirror
# pypto CI's activate.sh; CANN's te/tbe/... still resolve from its own dirs.
# Note that CANN's pypto_pro (same distribution) is removed as a consequence.
RUN SITE="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" && \
    test -n "$SITE" && \
    mkdir -p /opt/python-site && \
    ln -sfn "$SITE" /opt/python-site/site

ENV PYTHONPATH=/opt/python-site/site:${PYPTO_DIR}/runtime/python:${PYPTO_DIR}/runtime/examples/scripts
ENV PYTHONPATH=${PYTHONPATH}:${CANN_HOME}/python/site-packages:${CANN_HOME}/opp/built-in/op_impl/ai_core/tbe
ENV PYTHONPATH=${PYTHONPATH}:/usr/local/Ascend/ascend-toolkit/latest/python/site-packages:/usr/local/Ascend/ascend-toolkit/latest/opp/built-in/op_impl/ai_core/tbe

WORKDIR ${PYPTO_DIR}
CMD ["bash"]
